{% extends 'base.html.twig' %}

{% block title %}Edycja klucza API{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Edycja klucza: {{ apiKey.name }}</h1>
        <a href="{{ path('api_keys_index') }}" class="btn btn-outline-secondary">Powrót</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <p class="mb-1"><strong>Prefiks klucza:</strong> <code>{{ apiKey.tokenPrefix }}…</code></p>
            <p class="mb-0"><strong>Utworzono:</strong> {{ apiKey.createdAt|date('Y-m-d H:i') }}</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.permissions) }}
                {{ form_row(form.isActive) }}
                <div class="mt-3">
                    {{ form_row(form.submit) }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
