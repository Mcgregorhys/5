{% extends 'base.html.twig' %}

{% block title %}Nowy klucz API{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Utwórz klucz API</h1>
        <a href="{{ path('api_keys_index') }}" class="btn btn-outline-secondary">Anuluj</a>
    </div>

    <div class="card mb-4">
        <div class="card-header">Dostępne uprawnienia</div>
        <div class="card-body">
            <ul class="mb-0">
                {% for permission in permissions %}
                    <li>
                        <strong>{{ permission.label }}</strong>
                        <code class="ms-1">{{ permission.value }}</code>
                        <br><small class="text-muted">{{ permission.description }}</small>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.permissions) }}
                <div class="mt-3">
                    {{ form_row(form.submit) }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
