{% extends 'base.html.twig' %}

{% block title %}Lista produktów{% endblock %}

{% block body %}
<div class="row align-items-center mb-3">
    <div class="col-sm-4" style="padding-left: 200px;">TESTOWA APLIKACJA</div>
    <div class="col-sm-8 d-flex justify-content-end align-items-center flex-wrap">
        <form method="get" action="{{ path('product_list') }}" class="form-inline d-flex align-items-center mr-2 mb-2 mb-sm-0">
            <input
                type="search"
                name="q"
                value="{{ searchQuery|default('') }}"
                class="form-control form-control-sm"
                placeholder="Szukaj po kodzie, nazwie lub ID..."
                aria-label="Szukaj produktów"
                style="min-width: 240px;"
            >
            <button type="submit" class="btn btn-sm btn-primary ml-2">Szukaj</button>
            {% if searchQuery|default('') %}
                <a href="{{ path('product_list') }}" class="btn btn-sm btn-outline-secondary ml-1" title="Wyczyść wyszukiwanie">×</a>
            {% endif %}
        </form>
        <div class="dropdown">
            <a class="btn btn-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Logowanie/Rejestracja
            </a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('app_login') }}">Logowanie</a></li>
                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Wylogowanie</a></li>
                <li><a class="dropdown-item" href="{{ path('app_register') }}">Rejestracja</a></li>
                <li><a class="dropdown-item" href="{{ path('admin') }}">Dashboard</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="px-30 bg-blue-00">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="close" data-dismiss="alert" aria-label="Zamknij"><span aria-hidden="true">&times;</span></button>
            </div>
        {% endfor %}
    {% endfor %}
    <div class="mb-3 d-flex flex-wrap align-items-center justify-content-between">
        <div>
            <a class="btn btn-outline-primary" href="{{ path('product_new') }}">Dodaj</a>
        <a class="btn btn-outline-primary" href="{{ path('app_category_new') }}">Dodaj nową kategorię</a>
        <a class="btn btn-outline-primary" href="{{ path('add-category') }}">Przypisz nową kategorię</a>
        <a class="btn btn-outline-primary" href="{{ path('product_discounts') }}">Upusty</a>
        <a class="btn btn-outline-primary" href="{{ path('product_param') }}">Parametry</a>
        {% if app.user %}
            <a class="btn btn-outline-primary" href="{{ path('api_keys_index') }}">Klucze API</a>
        {% else %}
            <a class="btn btn-outline-warning" href="{{ path('app_login') }}" title="Wymaga logowania">Klucze API (zaloguj się)</a>
        {% endif %}
        <a class="btn btn-outline-primary" href="#api-endpoints">Endpointy API</a>
        {% if app.user %}
            <form method="post" action="{{ path('prestashop_import') }}" class="d-inline" onsubmit="return confirm('Zaimportować produkty z PrestaShop?');">
                <input type="hidden" name="_token" value="{{ csrf_token('prestashop_import') }}">
                <button type="submit" class="btn btn-outline-success">Import PrestaShop</button>
            </form>
            <form method="post" action="{{ path('prestashop_import_images') }}" class="d-inline" onsubmit="return confirm('Zaimportować zdjęcia produktów z PrestaShop?');">
                <input type="hidden" name="_token" value="{{ csrf_token('prestashop_import_images') }}">
                <button type="submit" class="btn btn-outline-success">Import zdjęć PrestaShop</button>
            </form>
        {% endif %}
        <a class="btn btn-outline-primary" href="{{ path('app_test') }}">PHP</a>
        <a class="btn btn-outline-primary" href="{{ path('app_instrwar') }}">Instrukcje warunkowe</a>
        </div>
        {% if totalProducts is defined and totalProducts > 0 %}
            <span class="text-muted">
                {% if searchQuery|default('') %}
                    Znaleziono {{ totalProducts }} produktów — wyświetlanie {{ (page - 1) * perPage + 1 }}–{{ min(page * perPage, totalProducts) }}
                {% else %}
                    Wyświetlanie {{ (page - 1) * perPage + 1 }}–{{ min(page * perPage, totalProducts) }} z {{ totalProducts }} produktów
                {% endif %}
            </span>
        {% elseif searchQuery|default('') %}
            <span class="text-muted">Brak produktów dla frazy „{{ searchQuery }}”</span>
        {% endif %}
    </div>

    <form method="post" action="{{ path('product_edit_or_delete') }}" enctype="multipart/form-data">
        <div class="table-container">
            <table class="responsive-table">
                <thead>
                    <tr>
                        <th class="w-auto">ID</th>
                        <th class="w-auto">Lp</th>
                        <th class="w-auto">Kod</th>
                        <th class="w-auto">Zdjęcie</th>
                        <th class="w-auto">Usuń zdjęcie</th>
                        <th class="min-w-[200px]">Nazwa produktu</th>
                        <th class="w-auto">Ilość</th>
                        <th class="w-auto">Cena netto</th>
                        <th class="w-auto">VAT (%)</th>
                        <th class="w-auto">Cena brutto</th>
                        <th class="w-auto">Wartość</th>
                        <th class="w-auto">Usuń</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr>
                            <td class="border-4 border-double border-blue-400 p-2">{{ product.id }}</td>
                            <td class="border-4 border-double border-blue-400 p-2">{{ (page - 1) * perPage + loop.index }}</td>
                            <td class="border-4 border-double border-blue-400 p-2 w-full md:w-auto">
                                <input type="text" name="products[{{ product.id }}][kod]" value="{{ product.kod }}" class="auto-input">
                            </td>
                            <td class="p-2">
                                {% if product.imageFilename %}
                                    <img src="{{ asset('uploads/products/' ~ product.imageFilename) }}" alt="zdjęcie" class="max-w-[100px]">
                                {% else %}
                                    <input type="file" name="product_images[{{ product.id }}]" class="auto-input">
                                {% endif %}
                            </td>
                            <td class="p-2">
                                {% if product.imageFilename %}
                                    <input type="checkbox" name="remove_image[]" value="{{ product.id }}" class="auto-input">
                                {% endif %}
                            </td>
                            <td class="border-4 border-double border-blue-400 p-2 align-top max-w-[200px]">
                                <input type="text" name="products[{{ product.id }}][nazwaProduktu]" value="{{ product.nazwaProduktu }}" class="auto-input">
                            </td>
                            <td class="border-4 border-double border-blue-400 p-2">
                                <input type="number" step="1" name="products[{{ product.id }}][amount]" value="{{ product.amount }}" class="auto-input">
                            </td>
                            <td class="border-4 border-double border-blue-400 p-2">
                                <input type="number" step="0.01" name="products[{{ product.id }}][cenaNetto]" value="{{ product.cenaNetto }}" class="auto-input">
                            </td>
                            <td class="border-4 border-double border-blue-400 p-2">
                                <input type="number" step="1" name="products[{{ product.id }}][vat]" value="{{ product.vat }}" class="auto-input">
                            </td>
                            <td class="border-4 border-double border-blue-400 p-2 w-full min-w-[100px]">
                                {{ (product.cenaNetto + (product.cenaNetto * product.vat / 100))|number_format(2, '.', ',') }}
                            </td>
                            <td class="border-4 border-double border-blue-400 p-2">
                                {{ ((product.cenaNetto + (product.cenaNetto * product.vat / 100)) * product.amount)|number_format(2, '.', ',') }}
                            </td>
                            <td class="border-4 border-double border-blue-400 p-2">
                                <input type="checkbox" name="to_delete[]" value="{{ product.id }}" class="auto-input">
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="12">
                                {% if searchQuery|default('') %}
                                    Brak produktów pasujących do wyszukiwania „{{ searchQuery }}”.
                                {% else %}
                                    Brak produktów w bazie danych.
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if totalPages is defined and totalPages > 1 %}
            {% set paginationParams = searchQuery|default('') ? {q: searchQuery} : {} %}
            <nav aria-label="Paginacja produktów" class="mt-3">
                <ul class="pagination flex-wrap">
                    <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                        {% if page <= 1 %}
                            <span class="page-link">«</span>
                        {% else %}
                            <a class="page-link" href="{{ path('product_list', paginationParams|merge({page: page - 1})) }}" aria-label="Poprzednia">«</a>
                        {% endif %}
                    </li>
                    {% set startPage = max(1, page - 2) %}
                    {% set endPage = min(totalPages, page + 2) %}
                    {% if startPage > 1 %}
                        <li class="page-item"><a class="page-link" href="{{ path('product_list', paginationParams|merge({page: 1})) }}">1</a></li>
                        {% if startPage > 2 %}
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        {% endif %}
                    {% endif %}
                    {% for p in startPage..endPage %}
                        <li class="page-item {{ p == page ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('product_list', paginationParams|merge({page: p})) }}">{{ p }}</a>
                        </li>
                    {% endfor %}
                    {% if endPage < totalPages %}
                        {% if endPage < totalPages - 1 %}
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        {% endif %}
                        <li class="page-item"><a class="page-link" href="{{ path('product_list', paginationParams|merge({page: totalPages})) }}">{{ totalPages }}</a></li>
                    {% endif %}
                    <li class="page-item {{ page >= totalPages ? 'disabled' : '' }}">
                        {% if page >= totalPages %}
                            <span class="page-link">»</span>
                        {% else %}
                            <a class="page-link" href="{{ path('product_list', paginationParams|merge({page: page + 1})) }}" aria-label="Następna">»</a>
                        {% endif %}
                    </li>
                </ul>
            </nav>
        {% endif %}

        <div class="mt-3 mb-2 p-2 bg-light border rounded">
            <strong>Wartość produktów brutto:</strong> {{ totalValue|default(0)|number_format(2, ',', ' ') }} zł
        </div>

        <div class="d-flex flex-wrap align-items-center mt-3 mb-4">
            <button type="submit" name="action" value="update" class="btn btn-secondary btn-sm mr-2">Zapisz zmiany</button>
            <button type="submit" name="action" value="delete" class="btn btn-secondary btn-sm mr-2">Usuń zaznaczone</button>

            <div class="btn-group">
                <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    Eksportuj
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="{{ path('products_export', {format: 'pdf'}) }}" target="_blank">PDF</a></li>
                    <li><a class="dropdown-item" href="{{ path('products_export', {format: 'xls'}) }}">Excel (XLSX)</a></li>
                    <li><a class="dropdown-item" href="{{ path('products_export', {format: 'csv'}) }}">CSV</a></li>
                </ul>
            </div>
        </div>
    </form>

    {% include 'product/_api_endpoints.html.twig' with {products: products} %}
</div>
{% endblock %}
